# Google Drive sync (optional). Client ids are public identifiers, not secrets.
# Create a project at https://console.cloud.google.com, enable the Drive API, and
# add one OAuth client per runtime:
#
#   Desktop app  -> VITE_GOOGLE_CLIENT_ID_DESKTOP
#   Web app      -> VITE_GOOGLE_CLIENT_ID_WEB
#                   Authorized JavaScript origins: http://localhost:5173 and the
#                   origin the app is deployed from.
#
# Leave both empty to build without Google Drive; WebDAV still works.
VITE_GOOGLE_CLIENT_ID_DESKTOP=
VITE_GOOGLE_CLIENT_ID_WEB=
