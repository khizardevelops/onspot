# Google Drive sync (optional). Client ids are public identifiers, not secrets.
# Create a project at https://console.cloud.google.com, enable the Drive API, and
# add one OAuth client per runtime:
#
#   Desktop app  -> VITE_GOOGLE_CLIENT_ID_DESKTOP
#   Web app      -> VITE_GOOGLE_CLIENT_ID_WEB
#                   Authorized JavaScript origins: http://localhost:5173 and the
#                   origin the app is deployed from.
#
# Leave both empty to build without Google Drive; WebDAV still works.
VITE_GOOGLE_CLIENT_ID_DESKTOP=
VITE_GOOGLE_CLIENT_ID_WEB=

# Optional override for the shared prompt database (see
# server/prompt-submissions/README.md). Empty uses the deployed onspot service;
# prompt sharing is on by default and can be turned off in Settings.
VITE_PROMPT_SUBMISSIONS_URL=

# Which implementation drives the app while the Rust core is being built up
# (docs/architecture/adr/002-core-backend-toggle.md). `legacy` is the default
# and runs today's TypeScript; `core` sends the features that have passed their
# parity gates through the bridge. Unset means `core`; set `legacy` for the old path.
VITE_CORE_BACKEND=legacy
