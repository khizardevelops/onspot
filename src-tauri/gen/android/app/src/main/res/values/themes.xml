<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The window background shows behind the system
         bars (see MainActivity), so it is the app's paper colour. -->
    <style name="Theme.onspot" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/onspot_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
