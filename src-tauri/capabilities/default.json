{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window: core APIs, the window controls of the app's own title bar (WindowBar), the SQL plugin, and the file access used by database export/import.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-save",
    "speech:default",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "http://*" },
        { "url": "http://*:*" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPCONFIG/onspot.db" },
        { "path": "$APPCONFIG/onspot.db-journal" },
        { "path": "$APPCONFIG/onspot.db-wal" },
        { "path": "$APPCONFIG/onspot.db-shm" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$TEMP/onspot-export-*.sqlite" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$TEMP/onspot-export-*.sqlite" },
        { "path": "$APPCONFIG/onspot.db-journal" },
        { "path": "$APPCONFIG/onspot.db-wal" },
        { "path": "$APPCONFIG/onspot.db-shm" }
      ]
    }
  ]
}
