{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window: core APIs, the window controls of the app's own title bar (WindowBar), and the dialogs and file access used by database export/restore and saved documents (paths come from the dialogs' dynamic scope).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-save",
    "dialog:allow-open",
    "speech:default",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "http://*" },
        { "url": "http://*:*" }
      ]
    },
    "fs:allow-write-file",
    "fs:allow-read-file"
  ]
}
