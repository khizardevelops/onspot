{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window: core APIs, the SQL plugin, and the file access used by database export/import.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPCONFIG/onspot.db" },
        { "path": "$APPCONFIG/onspot.db-journal" },
        { "path": "$APPCONFIG/onspot.db-wal" },
        { "path": "$APPCONFIG/onspot.db-shm" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$TEMP/onspot-export-*.sqlite" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$TEMP/onspot-export-*.sqlite" },
        { "path": "$APPCONFIG/onspot.db-journal" },
        { "path": "$APPCONFIG/onspot.db-wal" },
        { "path": "$APPCONFIG/onspot.db-shm" }
      ]
    }
  ]
}
