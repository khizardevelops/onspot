# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# SvelteKit
.svelte-kit/
build/
.vercel
.netlify

# Tauri. gen/android is the Android project Tauri generates and is meant to be
# committed (its own .gitignore drops build output); only generated schemas are ignored.
src-tauri/target/
src-tauri/gen/schemas/

# Android pipeline: machine-specific toolchain paths and release signing secrets
scripts/android.local.env
*.jks
*.keystore
src-tauri/gen/android/keystore.properties

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 18MB espeak-ng data for French G2P, restored via the copy step in commands.md
static/piper-wasm/

# Model-lab build output (tools/whisper-webgpu/build.sh), rebuilt locally
src/routes/model-lab/vendor/

# Local database dumps / exports
*.sqlite
*.sqlite3
*.db

# Generated repomix bundles (npm run bundle, npm run bundle:ui). The repomix/ folder and its
# bundle.mjs script are tracked; only the generated output is ignored.
repomix/*-bundle.*
archive/lab-ui-2026-09-13/
eval/

# Environment files: never commit tokens (VITE_* values are baked into builds)
.env
.env.*
!.env.example

# Android build artefacts copied out of src-tauri/gen/android (the generated
# project's own .gitignore already drops build/, .gradle/ and local.properties)
*.apk
*.aab
*.idsig
.kotlin/
.cxx/
src-tauri/gen/android/.idea/

# Claude Code local state (keep a shared settings.json if one is added)
.claude/*
!.claude/settings.json

# Test and tooling output
test-results/
playwright-report/
coverage/
*.tsbuildinfo
.eslintcache

# OS
Thumbs.db
