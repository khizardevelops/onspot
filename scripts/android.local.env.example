# Copy to scripts/android.local.env (gitignored) and point at your toolchain.
# Android Gradle needs JDK 17 or 21; Rust must come from rustup with the
# aarch64-linux-android (phones) and x86_64-linux-android (emulators) targets.
# ANDROID_HOME=$HOME/Android/sdk
# NDK_HOME=$HOME/Android/sdk/ndk/28.2.13676358
# JAVA_HOME=/path/to/jdk-21
# RUSTUP_HOME=/path/to/rustup
# CARGO_HOME=/path/to/cargo
# CARGO_TARGET_DIR=/path/outside/any/synced/folder/onspot-target
